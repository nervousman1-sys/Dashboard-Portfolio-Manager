# Copy to .env on the VPS (NEVER commit the real .env). The Docker container reads these.
SUPABASE_URL=https://jdebxhxaiwbtgweruznd.supabase.co
# REQUIRED — the service-role key bypasses RLS so the agent can act on every user's
# automated_strategies / portfolios / holdings. VPS-only secret. Get it from:
# Supabase Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SERVICE_ROLE_KEY_HERE
# Data API base (same endpoints the website uses)
SITE_URL=https://www.finextium.com
# Minutes between evaluation passes
STRATEGY_INTERVAL_MIN=5
